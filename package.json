{
  "name": "logimaster",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "pnpm --filter @logimaster/api db:migrate",
    "db:seed": "pnpm --filter @logimaster/api db:seed",
    "setup": "pnpm install && pnpm --filter @logimaster/contracts build && pnpm --filter @logimaster/api db:generate",
    "predev": "pnpm --filter @logimaster/contracts build",
    "dev": "pnpm --parallel --filter @logimaster/api --filter @logimaster/web dev",
    "dev:api": "pnpm --filter @logimaster/api dev",
    "dev:web": "pnpm --filter @logimaster/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @logimaster/api test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "load:verify": "docker compose exec -T db psql -U logimaster -d logimaster < tests/load/verify-consistency.sql",
    "load:reset": "docker compose exec -T db psql -U logimaster -d logimaster < tests/load/reset-transactions.sql"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.5.23",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  }
}
