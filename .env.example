# ルート直下の参考値。実際に読み込まれるのは apps/api/.env と apps/web/.env.local。
# セットアップ時に以下をコピーしてください。
#   apps/api/.env.example  -> apps/api/.env
#   apps/web/.env.example  -> apps/web/.env.local

# --- apps/api/.env ---
DATABASE_URL="postgresql://logimaster:logimaster@localhost:5432/logimaster?schema=public"
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# --- apps/web/.env.local ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
